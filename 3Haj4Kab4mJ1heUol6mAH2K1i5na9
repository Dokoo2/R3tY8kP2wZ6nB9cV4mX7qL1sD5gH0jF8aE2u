local function getSongNameById(id)
    for _, s in ipairs(MUSIC_LIST) do
        if tostring(s.id) == tostring(id) then return s.name or tostring(id) end
    end
    return tostring(id)
end

local function stopMusic()
    if currentMusicSound then
        pcall(function() currentMusicSound:Stop() end)
        pcall(function() currentMusicSound:Destroy() end)
        currentMusicSound = nil
    end
    musicPlaying = false
    currentMusicId = nil
end

local function playMusic(songId)
    stopMusic()
    currentMusicSound = Instance.new("Sound")
    currentMusicSound.SoundId = "rbxassetid://" .. tostring(songId)
    local vol = musicVolumes[tostring(songId)]
    currentMusicSound.Volume = vol or 0.5
    currentMusicSound.Looped = musicLoopEnabled and not musicShuffleEnabled
    currentMusicSound.Parent = SoundService
    pcall(function() currentMusicSound:Play() end)
    musicPlaying = true
    currentMusicId = tostring(songId)

    currentMusicSound.Ended:Connect(function()
        if not musicShuffleEnabled then return end
        if not currentMusicSound or currentMusicSound.SoundId ~= "rbxassetid://" .. tostring(songId) then return end
        local pool = {}
        for _, s in ipairs(MUSIC_LIST) do
            if tostring(s.id) ~= tostring(songId) then table.insert(pool, s.id) end
        end
        if #pool == 0 then return end
        local nextId = pool[math.random(1, #pool)]
        playMusic(nextId)
        if nowPlayingLbl then
            nowPlayingLbl.Text = "Now playing: " .. getSongNameById(nextId)
        end
    end)
end

