local function setupForceSpeed()
    cleanupForceSpeed()
    local hrp = getHRP()
    if not hrp then return end
    local part = Instance.new("Part")
    part.Name = "DokooHubForceSpeed"
    part.Size = Vector3.new(0.1, 0.1, 0.1)
