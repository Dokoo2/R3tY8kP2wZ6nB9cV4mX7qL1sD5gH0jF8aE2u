    local PHRASES = {
        "Loading assets...",
        "Preparing for you...",
        "Initializing modules...",
        "Configuring settings...",
        "Almost ready...",
    }

    local usedPhrases = {}
    local function pickRandomPhrase()
        if #usedPhrases >= #PHRASES then usedPhrases = {} end
        local pool = {}
        for _, p in ipairs(PHRASES) do
            local used = false
            for _, u in ipairs(usedPhrases) do
                if u == p then used = true; break end
            end
            if not used then table.insert(pool, p) end
        end
        local phrase = pool[math.random(1, #pool)]
        table.insert(usedPhrases, phrase)
        return phrase
    end

    local function setPhrase(text)
        phraseLbl.Text = text
        phraseLbl.TextTransparency = 0.8
        TweenService:Create(phraseLbl, TweenInfo.new(0.25), {TextTransparency = 0.15}):Play()
    end

    setPhrase(pickRandomPhrase())

    local phraseThread = task.spawn(function()
        while phraseLbl.Parent do
            task.wait(0.9)
            if not phraseLbl.Parent then break end
            setPhrase(pickRandomPhrase())
        end
    end)

    local function setProgress(p)
        p = math.clamp(p, 0, 1)
        fill.Size = UDim2.new(p, 0, 1, 0)
        pct.Text = math.floor(p * 100 + 0.5) .. "%"
    end

    local currentProgress = 0
    local function animateTo(target, duration)
        local startProgress = currentProgress
        local startTime = tick()
        local conn
        conn = RunService.RenderStepped:Connect(function()
            local t = math.clamp((tick() - startTime) / duration, 0, 1)
            local eased = 1 - (1 - t) ^ 3
            currentProgress = startProgress + (target - startProgress) * eased
            setProgress(currentProgress)
            if t >= 1 and conn then
                conn:Disconnect()
                currentProgress = target
                setProgress(target)
            end
        end)
        task.wait(duration)
    end

    local steps = {
        { target = 0.43, duration = 1.2, pause = 0.5 },
        { target = 0.79, duration = 1.6, pause = 1.2 },
        { target = 0.97, duration = 1.0, pause = 0.4 },
        { target = 1.00, duration = 0.6, pause = 0.0 },
    }

    for _, step in ipairs(steps) do
        animateTo(step.target, step.duration)
        if step.pause > 0 then
            setPhrase(pickRandomPhrase())
            task.wait(step.pause)
        end
    end

    if phraseThread then
        pcall(function() task.cancel(phraseThread) end)
    end

    for i = 1, 10 do
        card.BackgroundTransparency = 0.05 + (i / 10) * 0.95
        ttl.TextTransparency = i / 10
        sub.TextTransparency = i / 10
        loadLbl.TextTransparency = i / 10
        phraseLbl.TextTransparency = 0.15 + (i / 10) * 0.85
        barBg.BackgroundTransparency = i / 10
        fill.BackgroundTransparency = i / 10
        pct.TextTransparency = i / 10
        cs.Transparency = i / 10
        task.wait(0.02)
    end
