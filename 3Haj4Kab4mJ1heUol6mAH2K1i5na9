    weld.Part0 = hrp; weld.Part1 = part; weld.Parent = part
    local bodyVel = Instance.new("BodyVelocity")
    bodyVel.MaxForce = Vector3.new(1e5, 0, 1e5)
    bodyVel.Velocity = Vector3.zero
    bodyVel.Parent = part
