local espHighlights, espBillboards = {}, {}

local function cleanupESPForPlayer(player)
    if espHighlights[player] then espHighlights[player]:Destroy(); espHighlights[player] = nil end
    if espBillboards[player] then espBillboards[player]:Destroy(); espBillboards[player] = nil end
end

local function colorToRichTag(c)
    return string.format("rgb(%d,%d,%d)",
        math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
end

local function updateESP(player)
    if player == LocalPlayer then return end
    if not Config.ESP.Enabled then cleanupESPForPlayer(player); return end
    local character = player.Character
    if not character or not character.Parent then cleanupESPForPlayer(player); return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    local head = character:FindFirstChild("Head")
    if not humanoid or not rootPart or not head then return end

    local distance = (rootPart.Position - Camera.CFrame.Position).Magnitude

    local isTeammate = Config.Aim.Whitelist[player.Name] == true
    local fillCol, outlineCol

    if isTeammate and Config.ESP.WhitelistHighlight.Enabled then
        fillCol = Config.ESP.WhitelistHighlight.FillColor
        outlineCol = Config.ESP.WhitelistHighlight.OutlineColor
    else
        fillCol = Config.ESP.HighlightColor
        outlineCol = Config.ESP.OutlineColor
    end

    if distance < Config.ESP.MaxDistForHighlight then
        if not espHighlights[player] or not espHighlights[player].Parent then
            local h = Instance.new("Highlight")
            h.Name = "DokooHubESP_Highlight"; h.Adornee = character
            h.FillColor = fillCol; h.OutlineColor = outlineCol
            h.FillTransparency = 0.5; h.OutlineTransparency = 0
            h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            h.Parent = character; espHighlights[player] = h
        else
            espHighlights[player].Adornee = character
            espHighlights[player].FillColor = fillCol
            espHighlights[player].OutlineColor = outlineCol
        end
    else
        if espHighlights[player] then espHighlights[player]:Destroy(); espHighlights[player] = nil end
    end

    local infoBillboard = espBillboards[player]
    if not infoBillboard or not infoBillboard.Parent then
        infoBillboard = Instance.new("BillboardGui")
        infoBillboard.Name = "DokooHubESP_Info"
        infoBillboard.Adornee = head
        infoBillboard.Size = UDim2.new(0, 200, 0, 40)
        infoBillboard.StudsOffset = Vector3.new(0, 2.5, 0)
        infoBillboard.AlwaysOnTop = true
        infoBillboard.MaxDistance = math.huge
        infoBillboard.Parent = character

        local infoLbl = Instance.new("TextLabel")
        infoLbl.Name = "InfoLabel"
        infoLbl.Size = UDim2.new(1, 0, 1, 0)
        infoLbl.BackgroundTransparency = 1
        infoLbl.TextColor3 = Config.ESP.TextColor
        infoLbl.TextStrokeTransparency = 0
        infoLbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        infoLbl.TextSize = Config.ESP.TextSize
        infoLbl.Font = FONT_OPTIONS[Config.Font] or Enum.Font.Gotham
        infoLbl.TextXAlignment = Enum.TextXAlignment.Center
        infoLbl.TextYAlignment = Enum.TextYAlignment.Bottom
        infoLbl.RichText = true
        infoLbl.Parent = infoBillboard

        espBillboards[player] = infoBillboard
    end

    if infoBillboard then
        infoBillboard.Adornee = head
        infoBillboard.StudsOffset = Vector3.new(0, 2.5, 0)
        local lbl = infoBillboard:FindFirstChild("InfoLabel")
        if lbl then
            local lines = {}
            if Config.ESP.ShowName then
                lines[#lines + 1] = string.format('<font color="%s">%s</font>',
                    colorToRichTag(Config.ESP.TextColor), player.Name)
            end
            if Config.ESP.ShowHealth ~= false and humanoid then
                local hp = math.floor(humanoid.Health + 0.5)
                local maxHp = math.floor(humanoid.MaxHealth + 0.5)
                lines[#lines + 1] = string.format('<font color="%s">%d / %d HP</font>',
                    colorToRichTag(Config.ESP.TextColor), hp, maxHp)
            end
            if Config.ESP.ShowDistance then
                lines[#lines + 1] = string.format('<font color="%s">%d studs</font>',
                    colorToRichTag(Config.ESP.TextColor), math.floor(distance))
            end
            lbl.TextSize = Config.ESP.TextSize
            lbl.Font = FONT_OPTIONS[Config.Font] or Enum.Font.Gotham
            lbl.RichText = true
            lbl.Text = table.concat(lines, "\n")
        end
    end
end

